# WhatsApp Cloud API helper script config
# Copy to .env.local and fill with real values.

TOKEN=YOUR_META_ACCESS_TOKEN
API_VERSION=v25.0
GEMINI_MODEL=gemini-2.0-flash
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_FORMAT=mp3
SARVAM_TTS_FALLBACK_LANGUAGE=en-IN
SARVAM_TRANSLATE_MODEL=mayura:v1
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
INVOICE_EMAIL_FROM=invoices@example.com
INVOICE_EMAIL_REPLY_TO=support@example.com
RESEND_API_KEY=re_xxxxxxxxx
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=your_embedded_signup_config_id
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_SUCCESS_PATH=/merchant/onboarding
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v25.0
META_EMBEDDED_SIGNUP_REDIRECT_URI=
